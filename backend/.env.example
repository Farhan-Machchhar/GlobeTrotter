# ==========================================
# GlobeTrotter Backend — Environment Variables
# Copy this file to .env and fill in values
# ==========================================

# --- App ---
PROJECT_NAME=GlobeTrotter API
ENVIRONMENT=development
DEBUG=True

# --- Database ---
# SQLite (local dev — zero config)
DATABASE_URL=sqlite+aiosqlite:///./globetrotter.db

# PostgreSQL / Neon (production)
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xyz.neon.tech/globetrotter?sslmode=require

# --- Auth ---
JWT_SECRET=super-secret-globetrotter-hackathon-jwt-key-2026-change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# --- CORS ---
# Comma-separated list or JSON array — both work with pydantic-settings
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# --- External APIs ---
GEMINI_API_KEY=your_gemini_api_key_here
MAPBOX_TOKEN=your_mapbox_public_access_token_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
CLOUDINARY_URL=your_cloudinary_url_here

# --- Frontend (used by Vite) ---
VITE_API_URL=http://localhost:8000/api
VITE_MAPBOX_TOKEN=your_mapbox_public_access_token_here
VITE_USE_MOCK_API=false
